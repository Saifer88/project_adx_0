{
  "name": "adx",
  "version": "0.1.0-alpha",
  "description": "ADX: a compile-to-vanilla frontend framework built for AI coding agents. Token-efficient, SEO-safe static-HTML output.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "adx": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "tokens",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "lint": "eslint .",
    "benchmark": "tsc -p tsconfig.benchmark.json && node dist/benchmark/run.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "20.17.10",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "eslint": "9.17.0",
    "gpt-tokenizer": "2.9.0",
    "jsdom": "29.1.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "acorn": "8.19.0"
  }
}
